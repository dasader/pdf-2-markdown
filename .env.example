# 관리자 전체조회 키(비우면 관리자 기능 비활성)
PDF2MD_ADMIN_KEY=
# host 포트 (PORTS.md 규칙: NN=01)
PDF2MD_PORT=8001
# 진행률 추정용 초/페이지 (실측으로 보정)
PDF2MD_SEC_PER_PAGE=1.5
# 업로드 상한 페이지 수. 940p·15MB에서 peak 3.18GB로 worker mem_limit 5g 안이지만,
# "이미지 포함"을 켜면 크롭이 살아나 1000p 근처에서 OOM이 날 수 있다.
PDF2MD_MAX_PAGES=1000
# 표본 페이지 텍스트가 이보다 적으면 스캔본으로 보고 업로드를 거른다(OCR 미지원).
PDF2MD_MIN_TEXT_CHARS=10
